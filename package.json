{
  "name": "fuxi-fmt",
  "version": "0.16.0",
  "private": true,
  "description": "A Markdown formatter for Chinese technical writing",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/src/**/*.test.ts\"",
    "test:watch": "node --test --watch \"packages/*/src/**/*.test.ts\"",
    "typecheck": "tsc -p packages/core && tsc -p packages/cli && tsc -p packages/vscode",
    "fuxi-fmt": "node packages/cli/src/main.ts",
    "ci": "npm run typecheck && npm test",
    "build": "npm run build -w fuxi-fmt-vscode"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.138.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
