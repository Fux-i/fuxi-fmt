{
  "name": "fuxi-fmt-vscode",
  "displayName": "fuxi-fmt",
  "description": "%extension.description%",
  "version": "0.27.0",
  "private": true,
  "publisher": "Fux-i",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#5B7355",
    "theme": "light"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.138.0"
  },
  "l10n": "./l10n",
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "chinese",
    "cjk",
    "formatter",
    "punctuation",
    "spacing",
    "typography",
    "format-on-save",
    "zh"
  ],
  "main": "./dist/extension.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fux-i/fuxi-fmt.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/Fux-i/fuxi-fmt#readme",
  "bugs": {
    "url": "https://github.com/Fux-i/fuxi-fmt/issues"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "fuxi-fmt only reads its own JSON configuration and rewrites Markdown. It executes no code from the workspace."
    }
  },
  "contributes": {
    "configuration": {
      "title": "fuxi-fmt",
      "properties": {
        "fuxiFmt.enable": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%fuxiFmt.enable.description%"
        },
        "fuxiFmt.config": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "%fuxiFmt.config.description%"
        },
        "fuxiFmt.diagnostics.unmatchedBacktick": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.diagnostics.unmatchedBacktick.description%"
        },
        "fuxiFmt.diagnostics.unmatchedDollarSign": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.diagnostics.unmatchedDollarSign.description%"
        },
        "fuxiFmt.diagnostics.unclosedWikilink": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.diagnostics.unclosedWikilink.description%"
        },
        "fuxiFmt.diagnostics.unclosedLinkDestination": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.diagnostics.unclosedLinkDestination.description%"
        },
        "fuxiFmt.diagnostics.raggedTableRow": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.diagnostics.raggedTableRow.description%"
        },
        "fuxiFmt.diagnostics.listIndentJump": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.diagnostics.listIndentJump.description%"
        },
        "fuxiFmt.diagnostics.excludedList": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.diagnostics.excludedList.description%"
        },
        "fuxiFmt.diagnostics.tableMaxWidth": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.diagnostics.tableMaxWidth.description%"
        },
        "fuxiFmt.blankLines.aroundBlocks": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "exact",
          "scope": "resource",
          "enum": [
            "exact",
            "atLeast"
          ],
          "enumDescriptions": [
            "%fuxiFmt.blankLines.aroundBlocks.enum.0%",
            "%fuxiFmt.blankLines.aroundBlocks.enum.1%"
          ],
          "markdownDescription": "%fuxiFmt.blankLines.aroundBlocks.description%"
        },
        "fuxiFmt.blankLines.maxConsecutive": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": [
            "integer",
            "null"
          ],
          "default": 1,
          "scope": "resource",
          "minimum": 1,
          "markdownDescription": "%fuxiFmt.blankLines.maxConsecutive.description%"
        },
        "fuxiFmt.blankLines.insideLists": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "enum": [
            "remove",
            "one",
            "preserve"
          ],
          "default": "remove",
          "scope": "resource",
          "enumDescriptions": [
            "%fuxiFmt.blankLines.insideLists.enum.0%",
            "%fuxiFmt.blankLines.insideLists.enum.1%",
            "%fuxiFmt.blankLines.insideLists.enum.2%"
          ],
          "markdownDescription": "%fuxiFmt.blankLines.insideLists.description%"
        },
        "fuxiFmt.blankLines.insideBlockquotes": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "enum": [
            "trim",
            "preserve"
          ],
          "default": "trim",
          "scope": "resource",
          "enumDescriptions": [
            "%fuxiFmt.blankLines.insideBlockquotes.enum.0%",
            "%fuxiFmt.blankLines.insideBlockquotes.enum.1%"
          ],
          "markdownDescription": "%fuxiFmt.blankLines.insideBlockquotes.description%"
        },
        "fuxiFmt.thematicBreak": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "dashes",
          "scope": "resource",
          "enum": [
            "dashes",
            "asterisks",
            "underscores",
            "preserve"
          ],
          "enumDescriptions": [
            "%fuxiFmt.thematicBreak.enum.0%",
            "%fuxiFmt.thematicBreak.enum.1%",
            "%fuxiFmt.thematicBreak.enum.2%",
            "%fuxiFmt.thematicBreak.enum.3%"
          ],
          "markdownDescription": "%fuxiFmt.thematicBreak.description%"
        },
        "fuxiFmt.typography.cjkSpacing": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.typography.cjkSpacing.description%"
        },
        "fuxiFmt.typography.punctuationStyle": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "fullwidth",
          "scope": "resource",
          "enum": [
            "fullwidth",
            "halfwidth",
            "mixed",
            "off"
          ],
          "enumDescriptions": [
            "%fuxiFmt.typography.punctuationStyle.enum.0%",
            "%fuxiFmt.typography.punctuationStyle.enum.1%",
            "%fuxiFmt.typography.punctuationStyle.enum.2%",
            "%fuxiFmt.typography.punctuationStyle.enum.3%"
          ],
          "markdownDescription": "%fuxiFmt.typography.punctuationStyle.description%"
        },
        "fuxiFmt.typography.punctuationChangeList": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ",",
            ".",
            ":",
            "!",
            "?",
            ";"
          ],
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.typography.punctuationChangeList.description%"
        },
        "fuxiFmt.typography.halfwidthAlphanumerics": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.typography.halfwidthAlphanumerics.description%"
        },
        "fuxiFmt.typography.ideographicSpace": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.typography.ideographicSpace.description%"
        },
        "fuxiFmt.typography.hashtag": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.typography.hashtag.description%"
        },
        "fuxiFmt.typography.parenStyle": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "mixed",
          "scope": "resource",
          "enum": [
            "mixed",
            "fullwidth",
            "halfwidth",
            "preserve"
          ],
          "enumDescriptions": [
            "%fuxiFmt.typography.parenStyle.enum.0%",
            "%fuxiFmt.typography.parenStyle.enum.1%",
            "%fuxiFmt.typography.parenStyle.enum.2%",
            "%fuxiFmt.typography.parenStyle.enum.3%"
          ],
          "markdownDescription": "%fuxiFmt.typography.parenStyle.description%"
        },
        "fuxiFmt.typography.cjkClasses": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "array",
          "default": [
            "han"
          ],
          "scope": "resource",
          "items": {
            "enum": [
              "han",
              "kana",
              "hangul",
              "bopomofo",
              "enclosed"
            ],
            "enumDescriptions": [
              "%fuxiFmt.typography.cjkClasses.enum.0%",
              "%fuxiFmt.typography.cjkClasses.enum.1%",
              "%fuxiFmt.typography.cjkClasses.enum.2%",
              "%fuxiFmt.typography.cjkClasses.enum.3%",
              "%fuxiFmt.typography.cjkClasses.enum.4%"
            ]
          },
          "markdownDescription": "%fuxiFmt.typography.cjkClasses.description%"
        },
        "fuxiFmt.typography.spacingSymbols": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "array",
          "default": [
            "+",
            "-",
            "=",
            "<",
            ">",
            "%",
            "°",
            "℃",
            "℉"
          ],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "markdownDescription": "%fuxiFmt.typography.spacingSymbols.description%"
        },
        "fuxiFmt.typography.context": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "line",
          "scope": "resource",
          "enum": [
            "line",
            "adjacent"
          ],
          "enumDescriptions": [
            "%fuxiFmt.typography.context.enum.0%",
            "%fuxiFmt.typography.context.enum.1%"
          ],
          "markdownDescription": "%fuxiFmt.typography.context.description%"
        },
        "fuxiFmt.typography.quotes": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "paired",
          "scope": "resource",
          "enum": [
            "paired",
            "preserve"
          ],
          "enumDescriptions": [
            "%fuxiFmt.typography.quotes.enum.0%",
            "%fuxiFmt.typography.quotes.enum.1%"
          ],
          "markdownDescription": "%fuxiFmt.typography.quotes.description%"
        },
        "fuxiFmt.typography.emphasis.strong": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "preserve",
          "scope": "resource",
          "enum": [
            "asterisks",
            "underscores",
            "preserve"
          ],
          "enumDescriptions": [
            "%fuxiFmt.typography.emphasis.strong.enum.0%",
            "%fuxiFmt.typography.emphasis.strong.enum.1%",
            "%fuxiFmt.typography.emphasis.strong.enum.2%"
          ],
          "markdownDescription": "%fuxiFmt.typography.emphasis.strong.description%"
        },
        "fuxiFmt.typography.emphasis.em": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "preserve",
          "scope": "resource",
          "enum": [
            "asterisk",
            "underscore",
            "preserve"
          ],
          "enumDescriptions": [
            "%fuxiFmt.typography.emphasis.em.enum.0%",
            "%fuxiFmt.typography.emphasis.em.enum.1%",
            "%fuxiFmt.typography.emphasis.em.enum.2%"
          ],
          "markdownDescription": "%fuxiFmt.typography.emphasis.em.description%"
        },
        "fuxiFmt.typography.emphasis.strikethrough": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "preserve",
          "scope": "resource",
          "enum": [
            "double",
            "single",
            "preserve"
          ],
          "enumDescriptions": [
            "%fuxiFmt.typography.emphasis.strikethrough.enum.0%",
            "%fuxiFmt.typography.emphasis.strikethrough.enum.1%",
            "%fuxiFmt.typography.emphasis.strikethrough.enum.2%"
          ],
          "markdownDescription": "%fuxiFmt.typography.emphasis.strikethrough.description%"
        },
        "fuxiFmt.table.mode": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "normalize",
          "scope": "resource",
          "enum": [
            "preserve",
            "normalize"
          ],
          "enumDescriptions": [
            "%fuxiFmt.table.mode.enum.0%",
            "%fuxiFmt.table.mode.enum.1%"
          ],
          "markdownDescription": "%fuxiFmt.table.mode.description%"
        },
        "fuxiFmt.table.maxWidth": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "minimum": 1,
          "markdownDescription": "%fuxiFmt.table.maxWidth.description%"
        },
        "fuxiFmt.table.cjkWidth": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "enum": [
            2,
            1
          ],
          "default": 2,
          "scope": "resource",
          "enumDescriptions": [
            "%fuxiFmt.table.cjkWidth.enum.0%",
            "%fuxiFmt.table.cjkWidth.enum.1%"
          ],
          "markdownDescription": "%fuxiFmt.table.cjkWidth.description%"
        },
        "fuxiFmt.list.orderedStyle": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "keep-all-ones",
          "scope": "resource",
          "enum": [
            "renumber",
            "keep-all-ones",
            "preserve"
          ],
          "enumDescriptions": [
            "%fuxiFmt.list.orderedStyle.enum.0%",
            "%fuxiFmt.list.orderedStyle.enum.1%",
            "%fuxiFmt.list.orderedStyle.enum.2%"
          ],
          "markdownDescription": "%fuxiFmt.list.orderedStyle.description%"
        },
        "fuxiFmt.list.orderedDelimiter": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "preserve",
          "scope": "resource",
          "enum": [
            "preserve",
            ".",
            ")"
          ],
          "enumDescriptions": [
            "%fuxiFmt.list.orderedDelimiter.enum.0%",
            "%fuxiFmt.list.orderedDelimiter.enum.1%",
            "%fuxiFmt.list.orderedDelimiter.enum.2%"
          ],
          "markdownDescription": "%fuxiFmt.list.orderedDelimiter.description%"
        },
        "fuxiFmt.list.orderedIndent": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "enum": [
            "aligned",
            4
          ],
          "default": "aligned",
          "scope": "resource",
          "enumDescriptions": [
            "%fuxiFmt.list.orderedIndent.enum.0%",
            "%fuxiFmt.list.orderedIndent.enum.1%"
          ],
          "markdownDescription": "%fuxiFmt.list.orderedIndent.description%"
        },
        "fuxiFmt.list.unorderedIndent": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "enum": [
            "aligned",
            3,
            4
          ],
          "default": "aligned",
          "scope": "resource",
          "enumDescriptions": [
            "%fuxiFmt.list.unorderedIndent.enum.0%",
            "%fuxiFmt.list.unorderedIndent.enum.1%",
            "%fuxiFmt.list.unorderedIndent.enum.2%"
          ],
          "markdownDescription": "%fuxiFmt.list.unorderedIndent.description%"
        },
        "fuxiFmt.list.unorderedMarker": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "dashes",
          "scope": "resource",
          "enum": [
            "dashes",
            "asterisks",
            "preserve"
          ],
          "enumDescriptions": [
            "%fuxiFmt.list.unorderedMarker.enum.0%",
            "%fuxiFmt.list.unorderedMarker.enum.1%",
            "%fuxiFmt.list.unorderedMarker.enum.2%"
          ],
          "markdownDescription": "%fuxiFmt.list.unorderedMarker.description%"
        },
        "fuxiFmt.codeBlock.fenceChar": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "backticks",
          "scope": "resource",
          "enum": [
            "backticks",
            "tildes",
            "preserve"
          ],
          "enumDescriptions": [
            "%fuxiFmt.codeBlock.fenceChar.enum.0%",
            "%fuxiFmt.codeBlock.fenceChar.enum.1%",
            "%fuxiFmt.codeBlock.fenceChar.enum.2%"
          ],
          "markdownDescription": "%fuxiFmt.codeBlock.fenceChar.description%"
        },
        "fuxiFmt.codeBlock.fenceLength": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.codeBlock.fenceLength.description%"
        },
        "fuxiFmt.codeBlock.trimBlankLines": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.codeBlock.trimBlankLines.description%"
        },
        "fuxiFmt.endOfLine": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "lf",
          "scope": "resource",
          "enum": [
            "lf",
            "crlf",
            "auto"
          ],
          "enumDescriptions": [
            "%fuxiFmt.endOfLine.enum.0%",
            "%fuxiFmt.endOfLine.enum.1%",
            "%fuxiFmt.endOfLine.enum.2%"
          ],
          "markdownDescription": "%fuxiFmt.endOfLine.description%"
        },
        "fuxiFmt.ignore.file": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "fuxi-fmt-ignore-file",
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.ignore.file.description%"
        },
        "fuxiFmt.ignore.start": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "fuxi-fmt-ignore-start",
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.ignore.start.description%"
        },
        "fuxiFmt.ignore.end": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "fuxi-fmt-ignore-end",
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.ignore.end.description%"
        },
        "fuxiFmt.ignore.line": {
          "keywords": ["fuxi", "fuxi-fmt"],
          "type": "string",
          "default": "fuxi-fmt-ignore",
          "scope": "resource",
          "markdownDescription": "%fuxiFmt.ignore.line.description%"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "build": "node build.mjs",
    "vscode:prepublish": "node build.mjs"
  }
}
