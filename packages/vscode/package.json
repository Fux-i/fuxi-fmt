{
  "name": "fuxi-fmt-vscode",
  "displayName": "fuxi-fmt",
  "description": "Format Markdown for Chinese technical writing: blank lines, marker spacing, list renumbering, CJK to Latin spacing and Chinese punctuation width - with code, front matter and inline spans never touched.",
  "version": "0.22.0",
  "private": true,
  "publisher": "Fux-i",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#5B7355",
    "theme": "light"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "chinese",
    "cjk",
    "formatter",
    "punctuation",
    "spacing",
    "typography",
    "format-on-save",
    "zh"
  ],
  "main": "./dist/extension.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fux-i/fuxi-fmt.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/Fux-i/fuxi-fmt#readme",
  "bugs": {
    "url": "https://github.com/Fux-i/fuxi-fmt/issues"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "fuxi-fmt only reads its own JSON configuration and rewrites Markdown. It executes no code from the workspace."
    }
  },
  "contributes": {
    "configuration": {
      "title": "fuxi-fmt",
      "properties": {
        "fuxiFmt.enable": {
          "type": "boolean",
          "default": true,
          "description": "Format Markdown with fuxi-fmt."
        },
        "fuxiFmt.config": {
          "type": "object",
          "default": {},
          "description": "fuxi-fmt options, merged over the project fuxi-fmt.json. Editor settings win, so a personal preference does not require editing the repository."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "build": "node build.mjs",
    "vscode:prepublish": "node build.mjs"
  }
}
