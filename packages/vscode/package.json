{
  "name": "fuxi-fmt-vscode",
  "displayName": "fuxi-fmt",
  "description": "Format Markdown for Chinese technical writing",
  "version": "0.1.0",
  "private": true,
  "publisher": "fuxi",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Formatters"],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:markdown"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "fuxi-fmt only reads its own JSON configuration and rewrites Markdown. It executes no code from the workspace."
    }
  },
  "contributes": {
    "configuration": {
      "title": "fuxi-fmt",
      "properties": {
        "fuxiFmt.enable": {
          "type": "boolean",
          "default": true,
          "description": "Format Markdown with fuxi-fmt."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\""
  }
}
